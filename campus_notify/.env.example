# 复制为 .env 后按需修改（.env 已在 .gitignore 中）
DJANGO_SECRET_KEY=please-generate-a-random-secret-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# 识别服务：auto=有 key 用大模型，否则本地规则抽取器
EXTRACTION_PROVIDER=auto
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=20

# 校历第一周周一，用于解析“第 N 周周三”
TERM_START_DATE=2026-09-07

# 归并阈值（三区间决策）
MERGE_AUTO_THRESHOLD=0.86
MERGE_NEW_THRESHOLD=0.55
MERGE_LLM_RECHECK=0

# ---------------------------------------------------------------------------
# 邮件（注册绑定邮箱 / 找回密码的验证码）
# ---------------------------------------------------------------------------
# 开发默认打控制台：验证码直接出现在 runserver 日志里，不需要真实邮箱服务
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=校园通知助手 <no-reply@localhost>

# 生产改 SMTP（把上一行注释掉，用下面这组）：
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.qq.com
# EMAIL_PORT=465
# EMAIL_USE_SSL=1
# EMAIL_USE_TLS=0
# EMAIL_HOST_USER=you@qq.com
# EMAIL_HOST_PASSWORD=授权码
# DEFAULT_FROM_EMAIL=校园通知助手 <you@qq.com>

# 验证码策略
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_RESEND_SECONDS=60

# 开发便利：把验证码显示在页面上。
# 只在 DEBUG=1 时可能生效（代码里强制判断），生产（DEBUG=0）永远关闭。
EMAIL_DEV_SHOW_CODE=1

# ---------------------------------------------------------------------------
# 邮件提醒（提醒到点后发信给用户，FR-08 的主通道）
# ---------------------------------------------------------------------------
# 总开关：0 表示只派发站内通知，不发邮件（本地演示时可用）
EMAIL_REMINDER_ENABLED=1
# 单次派发最多发几封：用户离线多日再上线时，剩下的邮件留到下次派发
EMAIL_REMINDER_MAX_PER_DISPATCH=5
# 发件人，默认沿用 DEFAULT_FROM_EMAIL
# EMAIL_REMINDER_FROM=校园通知助手 <no-reply@localhost>
# 计划任务派发时没有请求对象，用这个地址拼邮件里的「事项详情」链接；
# 生产环境务必配置，例如 https://notify.example.edu
# SITE_BASE_URL=https://notify.example.edu
