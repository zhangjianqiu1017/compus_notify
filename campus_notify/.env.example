# 本地开发配置
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]

# 识别服务：auto = 有 key 用大模型，否则本地规则抽取
EXTRACTION_PROVIDER=auto
LLM_BASE_URL=LLM请求基地址
LLM_API_KEY=API-key
LLM_MODEL=模型名字
LLM_TIMEOUT=30
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.1

# 灰区是否让模型复核一次（默认关：不静默决定，交用户在确认页拍板）
MERGE_LLM_RECHECK=0

TERM_START_DATE=2026-09-07

# ---------------------------------------------------------------------------
# 邮件：QQ 邮箱 SMTP（465 端口用 SSL，注意 TLS 必须关，两者不能同时开）
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_USE_TLS=0
EMAIL_HOST_USER=your@qq.com
EMAIL_HOST_PASSWORD=SMTP 授权码
DEFAULT_FROM_EMAIL=校园通知助手 <your@qq.com>
EMAIL_TIMEOUT=20

# 验证码策略
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_RESEND_SECONDS=60

# 配置真实 SMTP 后就不需要页面上回显验证码了（仍然只在 DEBUG 下才可能生效）
EMAIL_DEV_SHOW_CODE=0